# ── Hermes-Personal-OS Environment Variables ──────────────────────────
# Copy to .env and fill in real values. Never commit .env to git.

# Notion API
NOTION_TOKEN=secret_XXXXXXXXXXXXXXXXXXXXXXXX
NOTION_JOB_DB_ID=XXXXXXXXXXXXXXXXXXXXX
NOTION_LBC_DB_ID=XXXXXXXXXXXXXXXXXXXXX
NOTION_LOGS_DB_ID=XXXXXXXXXXXXXXXXXXXXX

# Telegram Bot API
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz123456789
TELEGRAM_CHAT_ID=-1001234567890

# Retry policy (optional overrides)
MAX_ATTEMPTS=3
BACKOFF_FACTOR=2
